#include <iostream>
#include <iomanip>
using namespace std;

void InputMatrix(int** a, int n, int i = 0, int j = 0) {
    if (i == n) return;
    cout << "a[" << i << "][" << j << "] = ";
    cin >> a[i][j];
    if (j < n - 1)
        InputMatrix(a, n, i, j + 1);
    else
        InputMatrix(a, n, i + 1, 0);
}

void OutputMatrix(int** a, int n, int i = 0, int j = 0) {
    if (i == n) return;
    cout << setw(5) << a[i][j];  
    if (j < n - 1)
        OutputMatrix(a, n, i, j + 1);
    else {
        cout << endl;
        OutputMatrix(a, n, i + 1, 0);
    }
}

void RotateLayer(int** a, int n, int layer, int k) {
    if (layer >= n / 2) return; 
    int len = n - 2 * layer;
    int perim = 4 * (len - 1);
    k %= perim;

    for (int step = 0; step < k; step++) {
        int temp = a[layer][layer];
        for (int j = layer; j < n - layer - 1; j++)
            a[layer][j] = a[layer][j + 1];
        for (int i = layer; i < n - layer - 1; i++)
            a[i][n - layer - 1] = a[i + 1][n - layer - 1];
        for (int j = n - layer - 1; j > layer; j--)
            a[n - layer - 1][j] = a[n - layer - 1][j - 1];
        for (int i = n - layer - 1; i > layer + 1; i--)
            a[i][layer] = a[i - 1][layer];
        a[layer + 1][layer] = temp;
    }

    RotateLayer(a, n, layer + 1, k); 
}

void Part1_RotateMatrix(int** a, int n, int k) {
    RotateLayer(a, n, 0, k);
}

int CountZerosInCol(int** a, int n, int col, int i = 0) {
    if (i == n) return 0;
    return (a[i][col] == 0) + CountZerosInCol(a, n, col, i + 1);
}

int LastMaxZeroCol(int** a, int n, int col = 0, int maxZeros = -1, int lastCol = -1) {
    if (col == n) return lastCol;
    int zeros = CountZerosInCol(a, n, col);
    if (zeros >= maxZeros)
        return LastMaxZeroCol(a, n, col + 1, zeros, col);
    else
        return LastMaxZeroCol(a, n, col + 1, maxZeros, lastCol);
}

int Part2_LastMaxZeroCol(int** a, int n) {
    return LastMaxZeroCol(a, n);
}

int main() {
    int n, k;
    cout << "n = ";
    cin >> n;
    cout << "k = ";
    cin >> k;

    int** a = new int*[n];
    for (int i = 0; i < n; i++)
        a[i] = new int[n];

    InputMatrix(a, n);

    cout << "\nstart:\n";
    OutputMatrix(a, n);

    Part1_RotateMatrix(a, n, k);

    cout << "\nswap:\n";
    OutputMatrix(a, n);

    int col = Part2_LastMaxZeroCol(a, n);
    cout << "\nnom " << col + 1 << endl;

    for (int i = 0; i < n; i++)
        delete[] a[i];
    delete[] a;

    return 0;
}
